# Copy to .env and edit. All values are optional; defaults shown.

# Listen address (0.0.0.0 = all interfaces, 127.0.0.1 = local only)
#HOST=0.0.0.0

# HTTP port: REST API, dashboard, WebSocket JSON (/ws/v1), legacy WebSocket text
#HTTP_PORT=8081
# Legacy raw-text TCP port (connect with: nc localhost 8080)
#TCP_PORT=8080

# Comma-separated bearer keys for /api/* and /ws/v1. Empty = no authentication.
# When set, the unauthenticated legacy text interface is disabled unless LEGACY_ENABLED=true.
#GRUE_API_KEYS=
#LEGACY_ENABLED=true

# Concurrent sessions allowed (429 beyond this)
#MAX_SESSIONS=16
# End a session after this many ms without a command (ending: "timeout")
#IDLE_TIMEOUT_MS=600000
# How long to wait for the game to respond to one command
#COMMAND_TIMEOUT_MS=10000
# Turn limit when the request and the catalog give none
#DEFAULT_MAX_TURNS=1000
# Longest accepted command, in characters
#MAX_COMMAND_LENGTH=256

# Data directories (defaults are inside the project)
#GAMES_DIR=./games
#REPLAYS_DIR=./replays
#RESULTS_DIR=./results
